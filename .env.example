# GEMINI_API_KEY: Primary Gemini API key (also supports comma-separated keys).
# Optional extra keys for automatic round-robin load balancing & failover:
# GEMINI_API_KEY_1 through GEMINI_API_KEY_N (any count).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_API_KEY_6=""
GEMINI_API_KEY_7=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Private backend proxy base URL for standalone Android APK AI Rewrite.
# Set this in GitHub Repository Secrets (never put API keys in public repos).
VITE_API_BASE_URL=""
