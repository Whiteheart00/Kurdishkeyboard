{
  "$schema": "https://kurdikebord.github.io/rukar/style.json",
  "@defines": {
    "--bg": "#000000",
    "--surface-key-default": "#080808",
    "--surface-key-secondary": "#121212",
    "--surface-key-primary": "#000000",
    "--fg": "#FFFFFF",
    "--primary": "#FFD700",
    "--incognito": "#000000",
    "--fg-disabled": "#666666",
    "--fsz-xs": "11sp",
    "--fsz-sm": "14sp",
    "--fsz-md": "16sp",
    "--fsz-lg": "20sp",
    "--fsz-xl": "24sp",
    "--fsz-xxl": "28sp",
    "--shape-sm": "rounded-corner(5dp,5dp,5dp,5dp)",
    "--shape-md": "rounded-corner(6dp,6dp,6dp,6dp)",
    "--shape-lg": "rounded-corner(12dp,12dp,12dp,12dp)",
    "--shape-action-tile": "rounded-corner(30%,30%,30%,30%)",
    "--shape-bottom-sheet": "rounded-corner(30dp,30dp,0dp,0dp)",
    "--shape-popup": "rounded-corner(8dp,8dp,8dp,8dp)",
    "--elevation-popup": "4sp",
    "--m-toggle": "4dp 4dp 4dp 4dp",
    "--m-gap": "4dp 4dp 4dp 4dp",
    "--m-content-subheader": "6dp 12dp 6dp 6dp",
    "--p-xs": "2dp 2dp 2dp 2dp",
    "--p-sm": "4dp 4dp 4dp 4dp",
    "--p-content": "10dp 10dp 10dp 10dp",
    "--p-dialog": "16dp 16dp 16dp 16dp",
    "--p-bottom-sheet-header": "12dp 12dp 12dp 12dp",
    "--px-md": "8dp 0dp 8dp 0dp",
    "--py-btn": "0dp 2dp 0dp 2dp",
    "--mt-btn": "0dp 12dp 0dp 0dp"
  },
  "window": {
    "background": "var(--bg)",
    "foreground": "var(--fg)",
    "clip": "no"
  },
  "window[windowmode=`floating`]": {
    "shadow-elevation": "8dp",
    "shape": "rounded-corner(5%,5%,5%,5%)"
  },
  "window-move-handle[windowmode=`fixed`]": {
    "background": "var(--bg)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-xl)",
    "margin": "16dp 0dp 16dp 0dp",
    "padding": "var(--p-content)",
    "shape": "circle()"
  },
  "window-resize-action[windowmode=`fixed`]": {
    "background": "var(--primary)",
    "foreground": "#000000",
    "font-size": "var(--fsz-xl)",
    "padding": "8dp 8dp 8dp 8dp",
    "shape": "circle()"
  },
  "window-resize-action[windowmode=`floating`]": {
    "background": "#FFD700",
    "foreground": "#000000",
    "shape": "circle()"
  },
  "window-resize-handle": {
    "background": "var(--primary)"
  },
  "floating-dock-to-fixed-indicator": {
    "background": "var(--primary)"
  },
  "key": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-xl)",
    "shape": "var(--shape-sm)",
    "border-color": "#FFFFFF",
    "border-width": "0.7dp",
    "text-max-lines": "1",
    "font-weight": "bold"
  },
  "key[code=-211,-212,-227,-205,-203,-11,-7,1600]": {
    "background": "var(--surface-key-secondary)",
    "foreground": "#FFD700",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=-11,-7]": {
    "font-size": "var(--fsz-xxl)"
  },
  "key[code=-202,-201,10]": {
    "shape": "var(--shape-sm)"
  },
  "key[code=-201,-202]": {
    "background": "var(--surface-key-secondary)",
    "foreground": "#FFD700",
    "font-size": "var(--fsz-md)",
    "font-weight": "bold",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=-205]": {
    "text-max-lines": "2",
    "font-size": "var(--fsz-xs)",
    "font-weight": "bold",
    "text-align": "center"
  },
  "key[code=10]": {
    "background": "var(--surface-key-primary)",
    "foreground": "#FFD700",
    "border-color": "#FFD700",
    "border-width": "0.7dp",
    "font-weight": "bold"
  },
  "key[code=32]": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-xs)",
    "padding": "var(--p-sm)",
    "text-overflow": "ellipsis",
    "border-color": "#FFFFFF",
    "border-width": "0.7dp"
  },
  "key[code=-11][shiftstate=`caps_lock`]": {
    "foreground": "#000000",
    "background": "var(--primary)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=-202][mode=`numeric_advanced`]": {
    "foreground": "#FFD700",
    "background": "var(--surface-key-secondary)",
    "shape": "var(--shape-sm)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=-206,-207,-7,32,35,37,40..57,59,78][mode=`numeric`,`phone2`,`phone`]": {
    "shape": "var(--shape-sm)",
    "border-color": "#FFFFFF",
    "border-width": "0.7dp"
  },
  "key[code=-207][mode=`phone2`,`phone`]": {
    "background": "var(--surface-key-secondary)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=32,37,40,41,43,61][mode=`numeric_advanced`]": {
    "background": "var(--surface-key-secondary)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=32,45][mode=`numeric`,`phone2`,`phone`]": {
    "background": "var(--surface-key-secondary)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "key[code=44,46][mode=`phone2`]": {
    "foreground": "var(--fg)",
    "background": "var(--surface-key-default)",
    "border-color": "#FFFFFF",
    "border-width": "0.7dp"
  },
  "key:pressed": {
    "background": "#FFD700",
    "foreground": "#000000",
    "border-color": "#FFD700"
  },
  "key[code=-203,-202,-201,-11,-7,10]:pressed": {
    "background": "#FFD700",
    "foreground": "#000000",
    "border-color": "#FFD700"
  },
  "key[code=32]:pressed": {
    "background": "#FFD700",
    "foreground": "#000000"
  },
  "key[code=48..57,1632..1641,1776..1785][mode=`numeric_advanced`,`numeric`,`phone2`,`phone`]:pressed": {
    "background": "#FFD700",
    "foreground": "#000000"
  },
  "key:disabled": {
    "foreground": "var(--fg-disabled)"
  },
  "key-hint": {
    "foreground": "#FFD700",
    "font-size": "var(--fsz-xs)",
    "font-family": "inherit",
    "text-max-lines": "1",
    "margin": "0dp 1dp 3dp 1dp"
  },
  "key-popup-box": {
    "background": "#000000",
    "foreground": "#FFFFFF",
    "font-size": "var(--fsz-xl)",
    "shape": "var(--shape-popup)",
    "shadow-elevation": "var(--elevation-popup)",
    "border-color": "#FFD700",
    "border-width": "1dp"
  },
  "key-popup-element": {
    "shape": "var(--shape-sm)"
  },
  "key-popup-element[code=-255]": {
    "font-size": "var(--fsz-md)",
    "text-max-lines": "1"
  },
  "key-popup-element:focus": {
    "background": "var(--primary)",
    "foreground": "#000000",
    "shape": "var(--shape-sm)"
  },
  "key-popup-extended-indicator": {
    "font-size": "var(--fsz-sm)"
  },
  "clipboard-header": {
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-lg)",
    "padding": "var(--p-xs)"
  },
  "clipboard-header-button": {
    "background": "var(--surface-key-default)",
    "margin": "2dp 2dp 2dp 2dp",
    "shape": "circle()",
    "border-color": "#FFD700",
    "border-width": "0.6dp"
  },
  "clipboard-header-button:disabled": {
    "foreground": "var(--fg-disabled)"
  },
  "clipboard-header-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis",
    "margin": "6dp 0dp 0dp 0dp"
  },
  "clipboard-subheader": {
    "font-size": "var(--fsz-xs)",
    "margin": "var(--m-content-subheader)",
    "foreground": "var(--primary)",
    "font-weight": "bold"
  },
  "clipboard-content": {
    "padding": "10dp 0dp 10dp 0dp"
  },
  "clipboard-filter-row": {
    "background": "rgba(255,255,255,0)",
    "padding": "6dp 6dp 6dp 6dp",
    "shape": "circle()",
    "margin": "2dp 2dp 2dp 2dp"
  },
  "clipboard-filter-chip": {
    "background": "var(--surface-key-secondary)",
    "font-size": "var(--fsz-sm)",
    "padding": "10dp 6dp 10dp 6dp",
    "margin": "0dp 0dp 8dp 0dp",
    "shape": "circle()",
    "border-color": "#FFD700",
    "border-width": "0.6dp"
  },
  "clipboard-filter-chip[state=`active`]": {
    "background": "var(--primary)",
    "foreground": "#000000"
  },
  "clipboard-filter-chip-icon": {
    "shape": "circle()",
    "padding": "2dp 2dp 2dp 2dp"
  },
  "clipboard-filter-chip-text": {
    "margin": "4dp 0dp 0dp 0dp"
  },
  "clipboard-grid": {
    "shape": "var(--shape-lg)"
  },
  "clipboard-item": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-sm)",
    "shape": "var(--shape-lg)",
    "margin": "var(--m-gap)",
    "text-max-lines": "10",
    "text-overflow": "ellipsis",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "clipboard-item[type=`text`]": {
    "padding": "var(--p-content)"
  },
  "clipboard-item-description": {
    "foreground": "var(--primary)",
    "font-size": "var(--fsz-xs)",
    "font-weight": "medium",
    "padding": "var(--p-xs)",
    "shape": "circle()"
  },
  "clipboard-item-popup": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-sm)",
    "shape": "var(--shape-lg)",
    "margin": "var(--m-gap)",
    "border-color": "#FFD700",
    "border-width": "0.6dp"
  },
  "clipboard-item-popup[type=`text`]": {
    "padding": "var(--p-content)"
  },
  "clipboard-item-timestamp": {
    "font-size": "var(--fsz-xs)",
    "background": "var(--incognito)",
    "font-weight": "medium",
    "text-align": "center",
    "shape": "circle()",
    "margin": "6dp 4dp 6dp 0dp",
    "padding": "var(--p-sm)"
  },
  "clipboard-item-actions": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-md)",
    "shape": "var(--shape-lg)",
    "margin": "var(--m-gap)"
  },
  "clipboard-item-action": {
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-md)",
    "font-weight": "medium",
    "padding": "var(--p-content)"
  },
  "clipboard-item-action-icon": {
    "foreground": "var(--primary)",
    "shape": "circle()",
    "font-size": "var(--fsz-lg)"
  },
  "clipboard-item-action-text": {
    "margin": "8dp 0dp 0dp 0dp"
  },
  "clipboard-clear-all-dialog": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "shape": "var(--shape-lg)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "clipboard-clear-all-dialog-message": {
    "padding": "var(--p-dialog)"
  },
  "clipboard-clear-all-dialog-buttons": {
    "padding": "var(--p-sm)"
  },
  "clipboard-clear-all-dialog-button": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--primary)",
    "shape": "var(--shape-md)",
    "margin": "2dp 2dp 2dp 2dp"
  },
  "extracted-landscape-input-layout": {
    "background": "var(--bg)"
  },
  "extracted-landscape-input-field": {
    "background": "var(--bg)",
    "foreground": "var(--fg)",
    "shape": "var(--shape-md)",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "extracted-landscape-input-action": {
    "background": "var(--surface-key-primary)",
    "shape": "var(--shape-md)"
  },
  "glide-trail": {
    "foreground": "var(--primary)"
  },
  "incognito-mode-indicator": {
    "foreground": "var(--primary)"
  },
  "inline-autofill-chip": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-weight": "medium",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "media": {
    "padding": "var(--p-content)"
  },
  "media-emoji-subheader": {
    "font-size": "var(--fsz-md)",
    "font-weight": "bold",
    "margin": "var(--m-content-subheader)"
  },
  "media-emoji-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--fg)",
    "shape": "circle()"
  },
  "media-emoji-key-popup-box": {
    "background": "#000000",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-xl)",
    "shape": "circle()",
    "shadow-elevation": "var(--elevation-popup)",
    "border-color": "#FFD700",
    "border-width": "0.6dp"
  },
  "media-emoji-key-popup-element:focus": {
    "background": "var(--primary)",
    "foreground": "#000000",
    "shape": "circle()"
  },
  "media-emoji-tab": {
    "foreground": "var(--fg)"
  },
  "media-emoji-tab:focus": {
    "foreground": "var(--primary)"
  },
  "media-bottom-row": {
    "margin": "8dp 2dp 8dp 2dp"
  },
  "media-bottom-row-button": {
    "background": "#121212",
    "foreground": "#FFFFFF",
    "padding": "12dp 0dp 12dp 0dp",
    "shape": "circle()",
    "border-color": "#FFD700",
    "border-width": "0.6dp"
  },
  "one-handed-panel": {
    "background": "var(--bg)",
    "foreground": "var(--fg)"
  },
  "one-handed-panel-button": {
    "background": "var(--surface-key-default)",
    "font-size": "var(--fsz-xl)",
    "padding": "var(--p-content)",
    "shape": "circle()",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "smartbar": {
    "font-size": "var(--fsz-xl)"
  },
  "smartbar-shared-actions-toggle": {
    "background": "var(--surface-key-secondary)",
    "foreground": "#FFD700",
    "shape": "circle()",
    "margin": "var(--m-toggle)",
    "font-size": "inherit",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "smartbar-extended-actions-toggle": {
    "background": "var(--surface-key-secondary)",
    "foreground": "#FFD700",
    "shape": "circle()",
    "margin": "var(--m-toggle)",
    "font-size": "inherit",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "smartbar-action-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--fg)",
    "shape": "circle()",
    "font-size": "var(--fsz-lg)"
  },
  "smartbar-action-key[code=-233]": {
    "background": "var(--surface-key-default)",
    "margin": "var(--m-toggle)",
    "font-size": "inherit"
  },
  "smartbar-action-key:disabled": {
    "foreground": "var(--fg-disabled)"
  },
  "smartbar-action-tile": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "shape": "var(--shape-lg)",
    "font-size": "var(--fsz-sm)",
    "text-align": "center",
    "text-overflow": "ellipsis",
    "padding": "var(--p-xs)",
    "font-weight": "bold",
    "line-height": "var(--fsz-sm)",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "smartbar-action-tile:pressed": {
    "foreground": "#000000",
    "background": "#FFD700"
  },
  "smartbar-action-tile:disabled": {
    "foreground": "var(--fg-disabled)"
  },
  "smartbar-action-tile-icon": {
    "font-size": "var(--fsz-xl)",
    "background": "var(--surface-key-default)",
    "padding": "28dp 12dp 28dp 12dp",
    "shape": "var(--shape-md)"
  },
  "smartbar-action-tile-text": {
    "font-size": "var(--fsz-xs)",
    "text-max-lines": "1",
    "margin": "0dp 4dp 0dp 0dp"
  },
  "smartbar-actions-overflow-customize-button": {
    "background": "var(--surface-key-secondary)",
    "foreground": "#FFD700",
    "shape": "circle()",
    "font-size": "var(--fsz-md)",
    "margin": "var(--mt-btn)",
    "padding": "var(--py-btn)",
    "border-color": "#FFD700",
    "border-width": "0.7dp"
  },
  "smartbar-actions-editor": {
    "background": "var(--bg)",
    "shape": "var(--shape-bottom-sheet)"
  },
  "smartbar-actions-editor-header": {
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-lg)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis",
    "padding": "var(--p-bottom-sheet-header)"
  },
  "smartbar-actions-editor-header-button": {
    "shape": "circle()"
  },
  "smartbar-actions-editor-subheader": {
    "foreground": "var(--primary)",
    "font-size": "var(--fsz-md)",
    "font-weight": "bold",
    "padding": "12dp 16dp 12dp 8dp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile-grid": {
    "margin": "var(--m-gap)"
  },
  "smartbar-actions-editor-tile": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-xs)",
    "margin": "var(--m-gap)",
    "padding": "var(--p-sm)",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis",
    "line-height": "10sp",
    "shape": "var(--shape-action-tile)",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "smartbar-actions-editor-tile[code=-991]": {
    "foreground": "#FFD700"
  },
  "smartbar-actions-editor-tile[code=-999]": {
    "foreground": "var(--fg-disabled)"
  },
  "smartbar-candidate-word": {
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-md)",
    "shape": "var(--shape-md)",
    "padding": "var(--px-md)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-word:pressed": {
    "background": "#FFD700",
    "foreground": "#000000"
  },
  "smartbar-candidate-word-text": {
    "font-size": "var(--fsz-md)"
  },
  "smartbar-candidate-word-secondary-text": {
    "font-size": "var(--fsz-xs)"
  },
  "smartbar-candidate-clip": {
    "background": "var(--surface-key-default)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-sm)",
    "shape": "var(--shape-md)",
    "margin": "var(--m-gap)",
    "padding": "var(--px-md)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis",
    "font-weight": "bold",
    "border-color": "#FFFFFF",
    "border-width": "0.6dp"
  },
  "smartbar-candidate-clip:pressed": {
    "background": "#FFD700",
    "foreground": "#000000"
  },
  "smartbar-candidate-clip-icon": {
    "margin": "0dp 0dp 4dp 0dp",
    "font-size": "var(--fsz-lg)"
  },
  "smartbar-candidate-clip-text": {
    "font-size": "var(--fsz-sm)"
  },
  "smartbar-candidate-spacer": {
    "foreground": "#FFD700"
  },
  "subtype-panel": {
    "background": "var(--bg)",
    "foreground": "var(--fg)",
    "shape": "var(--shape-bottom-sheet)"
  },
  "subtype-panel-header": {
    "background": "var(--bg)",
    "foreground": "var(--fg)",
    "font-size": "var(--fsz-lg)",
    "padding": "var(--p-bottom-sheet-header)",
    "text-align": "center",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "subtype-panel-list": {
    "padding": "20dp 10dp 20dp 20dp"
  },
  "subtype-panel-list-item": {
    "padding": "0dp 10dp 0dp 10dp"
  },
  "subtype-panel-list-item-icon-leading": {
    "font-size": "var(--fsz-xxl)",
    "margin": "0dp 0dp 6dp 0dp"
  },
  "subtype-panel-list-item-text": {
    "font-size": "var(--fsz-md)"
  }
}
