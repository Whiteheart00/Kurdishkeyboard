{
	"$schema": "https://kurdikebord.github.io/rukar/style.json",
	"@defines": {
		"--bg": "rgba(20, 15, 8, 1)",
		"--primary": "rgba(255, 215, 0, 1)",
		"--primary-variant": "rgba(218, 165, 32, 1)",
		"--secondary": "rgba(255, 235, 150, 1)",
		"--surface": "rgba(45, 35, 18, 0.85)",
		"--surface-variant": "rgba(65, 50, 25, 0.9)",
		"--surface-pressed": "rgba(255, 215, 0, 0.35)",
		"--fg": "rgba(255, 248, 220, 0.98)",
		"--fg-hint": "rgba(255, 215, 0, 0.75)",
		"--fg-disabled": "rgba(255, 248, 220, 0.2)",
		"--shape": "rounded-corner(9dp,9dp,9dp,9dp)",
		"--shape-lg": "rounded-corner(20dp,20dp,20dp,20dp)",
		"--fsz-xs": "11sp",
		"--fsz-sm": "14sp",
		"--fsz-md": "16sp",
		"--fsz-lg": "18sp",
		"--fsz-xl": "22sp",
		"--fsz-xxl": "24sp",
		"--p-content": "10dp 10dp 10dp 10dp",
		"--m-toggle": "4dp 4dp 4dp 4dp"
	},
	"window": {
		"background": "var(--bg)",
		"foreground": "var(--fg)",
		"clip": "no"
	},
	"window-move-handle": {
		"background": "var(--bg)",
		"foreground": "var(--primary)",
		"font-size": "var(--fsz-xl)",
		"margin": "16dp 0dp 16dp 0dp",
		"padding": "var(--p-content)",
		"shape": "circle()"
	},
	"window-resize-action": {
		"background": "var(--primary)",
		"foreground": "rgba(20, 15, 8, 1)",
		"font-size": "var(--fsz-xl)",
		"padding": "8dp",
		"shape": "circle()"
	},
	"window-resize-handle": {
		"background": "var(--primary)"
	},
	"one-handed-panel": {
		"background": "var(--bg)"
	},
	"one-handed-panel-button": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"padding": "var(--p-content)",
		"border-color": "rgba(255, 215, 0, 0.35)",
		"border-width": "1.5dp"
	},
	"key": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape)",
		"shadow-elevation": "6dp",
		"shadow-color": "rgba(255, 215, 0, 0.25)",
		"border-color": "rgba(255, 215, 0, 0.45)",
		"border-width": "1.5dp",
		"text-max-lines": "1"
	},
	"key[code=-211,-212,-227,-205,-203,-11,-7,1600]": {
		"background": "var(--surface-variant)",
		"foreground": "var(--fg)"
	},
	"key[code=-11,-7]": {
		"font-size": "var(--fsz-xxl)"
	},
	"key[code=-201,-202]": {
		"font-size": "var(--fsz-md)",
		"font-weight": "bold"
	},
	"key[code=10]": {
		"background": "rgba(255, 215, 0, 0.35)",
		"foreground": "rgba(255, 255, 255, 1)",
		"shape": "var(--shape)",
		"shadow-elevation": "0dp",
		"border-color": "rgba(255, 215, 0, 0.7)",
		"border-width": "1.5dp"
	},
	"key[code=32]": {
		"background": "var(--surface-variant)",
		"font-size": "var(--fsz-xs)",
		"foreground": "var(--fg-hint)",
		"shadow-elevation": "0dp",
		"text-overflow": "ellipsis"
	},
	"key:pressed": {
		"background": "var(--surface-pressed)",
		"foreground": "rgba(255,255,255,1)",
		"shadow-elevation": "2dp"
	},
	"key:disabled": {
		"foreground": "var(--fg-disabled)"
	},
	"key-hint": {
		"foreground": "var(--fg-hint)",
		"font-size": "var(--fsz-xs)"
	},
	"key-popup-box": {
		"background": "rgba(45, 35, 18, 0.98)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape)",
		"shadow-elevation": "20dp",
		"shadow-color": "rgba(255, 215, 0, 0.5)",
		"border-color": "rgba(255, 215, 0, 0.7)",
		"border-width": "2dp"
	},
	"key-popup-element": {
		"shape": "var(--shape)"
	},
	"key-popup-element:focus": {
		"background": "var(--primary)",
		"foreground": "rgba(20, 15, 8, 1)",
		"shape": "var(--shape)"
	},
	"smartbar": {
		"background": "rgba(20, 15, 8, 0.8)",
		"font-size": "var(--fsz-md)"
	},
	"smartbar-shared-actions-toggle": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-extended-actions-toggle": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-action-key": {
		"background": "rgba(0,0,0,0)",
		"shape": "circle()"
	},
	"smartbar-action-key[code=-233]": {
		"background": "var(--surface)",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-candidate-word": {
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-md)"
	},
	"smartbar-candidate-word:pressed": {
		"background": "var(--surface-variant)"
	},
	"smartbar-action-tile": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape-lg)",
		"margin": "4dp",
		"border-color": "rgba(255, 215, 0, 0.35)",
		"border-width": "1.5dp"
	},
	"smartbar-action-tile-icon": {
		"foreground": "var(--primary)",
		"font-size": "var(--fsz-lg)"
	},
	"smartbar-actions-editor": {
		"background": "var(--bg)",
		"shape": "rounded-corner(24dp, 24dp, 0dp, 0dp)"
	},
	"smartbar-actions-editor-header": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"padding": "12dp"
	},
	"smartbar-actions-editor-subheader": {
		"foreground": "var(--primary)",
		"font-weight": "bold",
		"font-size": "var(--fsz-md)"
	},
	"smartbar-actions-editor-tile": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape)",
		"border-color": "var(--primary)",
		"border-width": "1.5dp",
		"font-size": "var(--fsz-xs)"
	},
	"clipboard-header": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-lg)"
	},
	"clipboard-subheader": {
		"font-size": "var(--fsz-xs)",
		"foreground": "var(--primary)",
		"font-weight": "bold"
	},
	"clipboard-filter-chip": {
		"background": "var(--surface)",
		"font-size": "var(--fsz-sm)",
		"shape": "circle()",
		"border-color": "rgba(255, 215, 0, 0.3)",
		"border-width": "1dp"
	},
	"clipboard-filter-chip[state=`active`]": {
		"background": "var(--primary)",
		"foreground": "var(--bg)"
	},
	"clipboard-item": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape)",
		"padding": "var(--p-content)",
		"margin": "4dp",
		"border-color": "rgba(255, 215, 0, 0.35)",
		"border-width": "1.5dp"
	},
	"clipboard-item-popup": {
		"background": "var(--surface-variant)",
		"foreground": "var(--fg)",
		"shape": "var(--shape)"
	},
	"clipboard-clear-all-dialog": {
		"background": "rgba(45, 35, 18, 0.98)",
		"foreground": "var(--fg)",
		"shape": "var(--shape)",
		"shadow-elevation": "16dp",
		"border-color": "rgba(255, 215, 0, 0.6)",
		"border-width": "1.5dp"
	},
	"clipboard-clear-all-dialog-button": {
		"foreground": "var(--primary)",
		"font-weight": "bold"
	},
	"subtype-panel": {
		"background": "var(--bg)",
		"foreground": "var(--fg)",
		"shape": "rounded-corner(24dp, 24dp, 0dp, 0dp)"
	},
	"subtype-panel-header": {
		"background": "var(--surface-variant)",
		"font-size": "var(--fsz-lg)",
		"padding": "12dp"
	},
	"emoji-key": {
		"background": "rgba(0,0,0,0)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape)"
	},
	"emoji-key:pressed": {
		"background": "var(--surface-pressed)",
		"foreground": "var(--fg)"
	},
	"media-emoji-key-popup-box": {
		"background": "rgba(45, 35, 18, 0.98)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape)",
		"shadow-elevation": "16dp",
		"shadow-color": "rgba(255, 215, 0, 0.5)",
		"border-color": "rgba(255, 215, 0, 0.7)",
		"border-width": "1.5dp"
	},
	"media-emoji-key-popup-element:focus": {
		"background": "var(--primary)",
		"foreground": "rgba(20, 15, 8, 1)",
		"shape": "var(--shape)"
	},
	"emoji-tab": {
		"foreground": "var(--fg-hint)"
	},
	"emoji-tab:focus": {
		"foreground": "var(--primary)"
	},
	"glide-trail": {
		"foreground": "var(--primary)"
	}
}
