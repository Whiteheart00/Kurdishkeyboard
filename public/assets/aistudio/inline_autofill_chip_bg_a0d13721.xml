<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#30ffffff">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/suggestions_chip_corner_radius"/>
            <gradient
                android:startColor="#5560a5fa"
                android:endColor="#551e40af"
                android:angle="270"
                android:type="linear"
                android:centerColor="#3b3b82f6"/>
            <stroke
                android:width="1dp"
                android:color="#50ffffff"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/suggestions_chip_corner_radius"/>
            <solid android:color="#15000000"/>
        </shape>
    </item>
</ripple>
