{
  "$schema": "https://kurdikebord.github.io/rukar/style.json",
  "@defines": {
    "--primary": "rgba(136,192,208,1)",
    "--secondary": "rgba(136,192,208,1)",
    "--primary-variant": "rgba(129,161,193,1)",
    "--background": "rgba(46,52,64,1)",
    "--surface": "rgba(59,66,82,1)",
    "--surface-variant": "rgba(67,76,94,1)",
    "--disabled": "rgba(67,76,94,1)",
    "--popup-surface": "rgba(76,86,106,1)",
    "--focused-popup-surface": "rgba(110,115,141,1)",
    "--drag-marker": "rgba(163,190,140,1)",
    "--spacer-color": "rgba(202,211,245,0.3019608)",
    "--one-hand-background": "rgba(46,52,64,1)",
    "--one-hand-foreground": "rgba(216,222,233,1)",
    "--incognito-icon-color": "rgba(202,211,245,0.06666667)",
    "--on-primary": "rgba(30,32,48,1)",
    "--on-background": "rgba(129,161,193,1)",
    "--on-background-disabled": "rgba(184,192,224,0.28235295)",
    "--on-surface": "rgba(216,222,233,1)",
    "--on-surface-variant": "rgba(229,233,240,1)",
    "--shape": "rounded-corner(8dp,8dp,8dp,8dp)",
    "--shape-variant": "rounded-corner(12dp,12dp,12dp,12dp)"
  },
  "window": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "clip": "no"
  },
  "key": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "22sp",
    "shadow-elevation": "2dp",
    "shape": "var(--shape)",
    "text-max-lines": "1"
  },
  "key[code=-201,-202,-203]": {
    "font-size": "17sp",
    "shape": "rounded-corner(45%,45%,45%,45%)",
    "background": "var(--secondary)",
    "foreground": "var(--background)"
  },
  "key[code=-204,-205]": {
    "font-size": "12sp"
  },
  "key[code=-205]": {
    "text-max-lines": "2"
  },
  "key[code=10]": {
    "background": "var(--primary)",
    "foreground": "var(--background)",
    "shape": "rounded-corner(45%,45%,45%,45%)"
  },
  "key[code=32]": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface-variant)",
    "font-size": "12sp",
    "text-overflow": "ellipsis"
  },
  "key[code=-11][shiftstate=`caps_lock`]": {
    "foreground": "var(--secondary)"
  },
  "key:pressed": {
    "background": "var(--surface-variant)",
    "foreground": "var(--on-surface)"
  },
  "key[code=-201,-202,-203,10]:pressed": {
    "background": "var(--primary-variant)",
    "foreground": "var(--background)",
    "shape": "rounded-corner(41%,41%,41%,41%)"
  },
  "key[code=-7]:pressed": {
    "foreground": "var(--secondary)"
  },
  "key-hint": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-surface-variant)",
    "font-family": "monospace",
    "font-size": "12sp",
    "padding": "0dp 1dp 2dp 0dp",
    "text-max-lines": "1"
  },
  "key-popup-box": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "shadow-elevation": "2dp"
  },
  "key-popup-element:focus": {
    "background": "var(--focused-popup-surface)",
    "shape": "var(--shape)"
  },
  "key-popup-extended-indicator": {
    "font-size": "16sp"
  },
  "clipboard-header": {
    "foreground": "var(--on-background)",
    "font-size": "20.5sp"
  },
  "clipboard-header-button": {
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "circle()"
  },
  "clipboard-header-button:disabled": {
    "foreground": "var(--on-background-disabled)"
  },
  "clipboard-header-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-subheader": {
    "font-size": "18sp",
    "margin": "6dp 6dp 6dp 6dp"
  },
  "clipboard-content": {
    "padding": "10dp 10dp 10dp 10dp"
  },
  "clipboard-item": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "15sp",
    "margin": "4dp 4dp 4dp 4dp",
    "padding": "12dp 8dp 12dp 8dp",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "2dp"
  },
  "clipboard-item-popup": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "2dp"
  },
  "clipboard-clear-all-dialog": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "shape": "var(--shape-variant)",
    "shadow-elevation": "1dp"
  },
  "clipboard-clear-all-dialog-message": {
    "padding": "16dp 16dp 16dp 16dp"
  },
  "clipboard-clear-all-dialog-buttons": {
    "padding": "4dp 4dp 4dp 4dp"
  },
  "clipboard-clear-all-dialog-button": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-surface)",
    "shape": "var(--shape-variant)"
  },
  "clipboard-history-disabled-title": {
    "font-weight": "bold"
  },
  "clipboard-history-disabled-message": {
    "padding": "0dp 4dp 0dp 8dp"
  },
  "clipboard-history-disabled-button": {
    "background": "var(--primary)",
    "foreground": "var(--on-primary)",
    "shape": "rounded-corner(24dp,24dp,24dp,24dp)"
  },
  "clipboard-history-locked-title": {
    "font-weight": "bold",
    "text-align": "center"
  },
  "clipboard-history-locked-message": {
    "padding": "0dp 4dp 0dp 0dp",
    "text-align": "center"
  },
  "extracted-landscape-input-layout": {
    "background": "var(--background)"
  },
  "extracted-landscape-input-field": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-background)",
    "font-size": "16sp",
    "shape": "rounded-corner(12dp,12dp,12dp,12dp)",
    "border-color": "var(--secondary)",
    "border-width": "2dp"
  },
  "extracted-landscape-input-action": {
    "background": "var(--primary)",
    "foreground": "var(--on-surface)",
    "shape": "rounded-corner(4dp,4dp,4dp,4dp)"
  },
  "glide-trail": {
    "foreground": "var(--secondary)"
  },
  "incognito-mode-indicator": {
    "foreground": "var(--incognito-icon-color)"
  },
  "media-emoji-subheader": {
    "font-weight": "bold",
    "margin": "4dp 4dp 4dp 4dp"
  },
  "media-emoji-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-background)",
    "font-size": "22sp",
    "shape": "var(--shape)"
  },
  "media-emoji-key:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)"
  },
  "media-emoji-key-popup-box": {
    "background": "var(--popup-surface)",
    "foreground": "var(--on-surface)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "shadow-elevation": "2dp"
  },
  "media-emoji-key-popup-element:focus": {
    "background": "var(--focused-popup-surface)",
    "shape": "var(--shape)"
  },
  "media-emoji-key-popup-extended-indicator": {
    "foreground": "inherit"
  },
  "media-emoji-tab": {
    "foreground": "var(--on-background)"
  },
  "media-emoji-tab:focus": {
    "foreground": "var(--primary)"
  },
  "media-bottom-row-button": {
    "padding": "16dp 0dp 16dp 0dp",
    "shape": "var(--shape)"
  },
  "one-handed-panel": {
    "background": "var(--one-hand-background)",
    "foreground": "var(--one-hand-foreground)",
    "margin": "0dp 0dp 2dp 0dp"
  },
  "one-handed-panel-button": {
    "shape": "circle()",
    "background": "var(--surface)",
    "font-size": "20sp",
    "margin": "5dp 40dp 5dp 33dp"
  },
  "smartbar": {
    "font-size": "20sp"
  },
  "smartbar-shared-actions-toggle": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "margin": "6dp 6dp 6dp 6dp",
    "shape": "circle()",
    "shadow-elevation": "2dp"
  },
  "smartbar-extended-actions-toggle": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-surface-variant)",
    "shape": "circle()"
  },
  "smartbar-action-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-background)",
    "margin": "2dp 2dp 2dp 2dp",
    "shape": "var(--shape)"
  },
  "smartbar-action-key:disabled": {
    "foreground": "var(--on-background-disabled)"
  },
  "smartbar-action-tile": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-background)",
    "font-size": "14sp",
    "margin": "4dp 0dp 4dp 0dp",
    "shape": "var(--shape)",
    "text-max-lines": "2",
    "text-align": "center",
    "text-overflow": "ellipsis"
  },
  "smartbar-action-tile:disabled": {
    "foreground": "var(--on-background-disabled)"
  },
  "smartbar-action-tile-icon": {
    "font-size": "18sp"
  },
  "smartbar-actions-overflow-customize-button": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "14sp",
    "shape": "circle()"
  },
  "smartbar-actions-editor": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "shape": "rounded-corner(24dp,24dp,0dp,0dp)"
  },
  "smartbar-actions-editor-header": {
    "background": "var(--background)",
    "foreground": "var(--on-surface)",
    "font-size": "20sp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis",
    "text-align": "center"
  },
  "smartbar-actions-editor-header-button": {
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "circle()"
  },
  "smartbar-actions-editor-subheader": {
    "foreground": "var(--on-background)",
    "font-size": "18sp"
  },
  "smartbar-actions-editor-tile-grid": {
    "margin": "8dp 8dp 10dp 8dp"
  },
  "smartbar-actions-editor-tile": {
    "font-size": "15.5sp",
    "margin": "0dp 4dp 4dp 4dp",
    "padding": "2dp 2dp 2dp 2dp",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile[code=-991]": {
    "foreground": "var(--drag-marker)"
  },
  "smartbar-actions-editor-tile[code=-999]": {
    "foreground": "var(--on-background-disabled)"
  },
  "smartbar-candidate-word": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--primary)",
    "font-size": "15sp",
    "font-weight": "normal",
    "padding": "10dp 4dp 10dp 4dp",
    "shape": "rectangle()",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-word:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-background)"
  },
  "smartbar-candidate-clip": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--on-surface)",
    "font-size": "15sp",
    "margin": "4dp 4dp 4dp 2dp",
    "padding": "10dp 0dp 10dp 0dp",
    "shape": "rectangle()"
  },
  "smartbar-candidate-clip:pressed": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)"
  },
  "smartbar-candidate-clip-icon": {
    "font-size": "18sp",
    "margin": "0dp 0dp 8dp 0dp"
  },
  "smartbar-candidate-spacer": {
    "foreground": "var(--spacer-color)"
  },
  "subtype-panel": {
    "background": "var(--background)",
    "foreground": "var(--on-background)",
    "shape": "rounded-corner(24dp,24dp,0dp,0dp)"
  },
  "subtype-panel-header": {
    "background": "var(--surface)",
    "foreground": "var(--on-surface)",
    "font-size": "18sp",
    "padding": "12dp 12dp 12dp 12dp",
    "text-align": "center",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-item-popup-action": {
    "font-size": "16sp",
    "padding": "12dp 12dp 12dp 12dp"
  }
}