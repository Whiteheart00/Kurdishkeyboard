{
	"$schema": "https://kurdikebord.github.io/rukar/style.json",
	"@defines": {
		"--bg": "rgba(242, 245, 250, 1)",
		"--primary": "rgba(0, 122, 255, 1)",
		"--primary-variant": "rgba(0, 100, 220, 1)",
		"--secondary": "rgba(90, 200, 250, 1)",
		"--surface": "rgba(255, 255, 255, 0.9)",
		"--surface-variant": "rgba(230, 238, 250, 0.95)",
		"--surface-pressed": "rgba(0, 122, 255, 0.18)",
		"--fg": "rgba(20, 30, 45, 0.95)",
		"--fg-hint": "rgba(90, 105, 130, 0.7)",
		"--fg-disabled": "rgba(0, 0, 0, 0.2)",
		"--shape-sm": "rounded-corner(8dp,8dp,8dp,8dp)",
		"--shape-md": "rounded-corner(10dp,10dp,10dp,10dp)",
		"--shape-lg": "rounded-corner(20dp,20dp,20dp,20dp)",
		"--fsz-xs": "11sp",
		"--fsz-sm": "14sp",
		"--fsz-md": "16sp",
		"--fsz-lg": "18sp",
		"--fsz-xl": "22sp",
		"--fsz-xxl": "24sp",
		"--p-content": "10dp 10dp 10dp 10dp",
		"--shape-popup": "rounded-corner(10dp,10dp,10dp,10dp)",
		"--m-toggle": "4dp 4dp 4dp 4dp"
	},
	"window": {
		"background": "var(--bg)",
		"foreground": "var(--primary)",
		"clip": "no"
	},
	"window-move-handle": {
		"background": "rgba(200, 215, 235, 0.5)",
		"foreground": "var(--primary)",
		"shape": "circle()",
		"padding": "var(--p-content)"
	},
	"window-resize-action": {
		"background": "var(--primary)",
		"foreground": "rgba(255,255,255,1)",
		"shape": "circle()",
		"padding": "8dp"
	},
	"window-resize-handle": {
		"background": "var(--primary)"
	},
	"one-handed-panel": {
		"background": "rgba(242, 245, 250, 1)"
	},
	"one-handed-panel-button": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"padding": "var(--p-content)",
		"border-color": "rgba(200, 215, 235, 0.8)",
		"border-width": "1.2dp"
	},
	"key": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape-md)",
		"shadow-elevation": "2dp",
		"shadow-color": "rgba(0, 0, 0, 0.08)",
		"border-color": "rgba(200, 215, 235, 0.8)",
		"border-width": "1.2dp",
		"text-max-lines": "1"
	},
	"key[code=-211,-212,-227,-205,-203,-11,-7,1600]": {
		"background": "var(--surface-variant)",
		"foreground": "var(--fg)"
	},
	"key[code=10]": {
		"background": "rgba(0, 122, 255, 0.35)",
		"foreground": "var(--primary)",
		"shape": "var(--shape-md)",
		"shadow-elevation": "0dp",
		"border-color": "rgba(0, 122, 255, 0.6)",
		"border-width": "1.2dp"
	},
	"key[code=32]": {
		"background": "rgba(0, 0, 0, 0.03)",
		"font-size": "var(--fsz-xs)",
		"foreground": "var(--fg-hint)",
		"shadow-elevation": "0dp",
		"text-overflow": "ellipsis"
	},
	"key:pressed": {
		"background": "var(--surface-pressed)",
		"foreground": "var(--fg)",
		"shadow-elevation": "1dp"
	},
	"key-hint": {
		"foreground": "var(--fg-hint)",
		"font-size": "var(--fsz-xs)"
	},
	"key-popup-box": {
		"background": "rgba(255, 255, 255, 0.98)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape-popup)",
		"shadow-elevation": "12dp",
		"shadow-color": "rgba(0, 0, 0, 0.15)",
		"border-color": "rgba(200, 215, 235, 0.9)",
		"border-width": "1.5dp"
	},
	"key-popup-element": {
		"shape": "var(--shape-popup)"
	},
	"key-popup-element:focus": {
		"background": "var(--primary)",
		"foreground": "rgba(255,255,255,1)",
		"shape": "var(--shape-popup)"
	},
	"smartbar": {
		"background": "rgba(230, 238, 250, 0.8)",
		"font-size": "var(--fsz-md)"
	},
	"smartbar-shared-actions-toggle": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-extended-actions-toggle": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "circle()",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-action-key": {
		"background": "rgba(0,0,0,0)",
		"shape": "circle()"
	},
	"smartbar-action-key[code=-233]": {
		"background": "var(--surface)",
		"margin": "var(--m-toggle)",
		"font-size": "inherit"
	},
	"smartbar-candidate-word": {
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-md)"
	},
	"smartbar-candidate-word:pressed": {
		"background": "var(--surface-variant)"
	},
	"smartbar-action-tile": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape-lg)",
		"margin": "4dp",
		"border-color": "rgba(200, 215, 235, 0.8)",
		"border-width": "1.2dp"
	},
	"smartbar-action-tile-icon": {
		"foreground": "var(--primary)",
		"font-size": "var(--fsz-lg)"
	},
	"smartbar-actions-editor": {
		"background": "rgba(242, 245, 250, 1)",
		"shape": "rounded-corner(24dp, 24dp, 0dp, 0dp)"
	},
	"smartbar-actions-editor-header": {
		"foreground": "var(--fg)"
	},
	"smartbar-actions-editor-subheader": {
		"foreground": "var(--primary)",
		"font-weight": "bold"
	},
	"smartbar-actions-editor-tile": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape-md)",
		"border-color": "rgba(200, 215, 235, 0.8)",
		"border-width": "1.2dp"
	},
	"clipboard-header": {
		"background": "rgba(242, 245, 250, 1)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-lg)"
	},
	"clipboard-item": {
		"background": "var(--surface)",
		"foreground": "var(--fg)",
		"shape": "var(--shape-md)",
		"padding": "var(--p-content)",
		"margin": "4dp",
		"border-color": "rgba(200, 215, 235, 0.8)",
		"border-width": "1.2dp"
	},
	"clipboard-subheader": {
		"foreground": "var(--primary)",
		"font-weight": "bold",
		"font-size": "var(--fsz-xs)"
	},
	"clipboard-filter-chip[state=`active`]": {
		"background": "var(--primary)",
		"foreground": "#FFFFFF"
	},
	"clipboard-clear-all-dialog": {
		"background": "rgba(255, 255, 255, 0.98)",
		"foreground": "var(--fg)",
		"shape": "var(--shape-md)",
		"shadow-elevation": "12dp",
		"shadow-color": "rgba(0, 0, 0, 0.15)",
		"border-color": "rgba(200, 215, 235, 0.9)",
		"border-width": "1.5dp"
	},
	"clipboard-clear-all-dialog-message": {
		"padding": "var(--p-content)"
	},
	"clipboard-clear-all-dialog-button": {
		"foreground": "var(--primary)",
		"font-weight": "bold"
	},
	"subtype-panel": {
		"background": "rgba(242, 245, 250, 1)",
		"foreground": "var(--fg)",
		"shape": "rounded-corner(24dp, 24dp, 0dp, 0dp)"
	},
	"subtype-panel-header": {
		"background": "rgba(200, 215, 235, 0.4)",
		"font-size": "var(--fsz-lg)",
		"padding": "12dp"
	},
	"media": {
		"padding": "var(--p-content)"
	},
	"media-emoji-key": {
		"shape": "circle()"
	},
	"media-emoji-key-popup-box": {
		"background": "rgba(255, 255, 255, 0.98)",
		"foreground": "var(--fg)",
		"font-size": "var(--fsz-xl)",
		"shape": "var(--shape-popup)",
		"shadow-elevation": "12dp",
		"shadow-color": "rgba(0, 0, 0, 0.15)",
		"border-color": "rgba(200, 215, 235, 0.9)",
		"border-width": "1.5dp"
	},
	"media-emoji-key-popup-element:focus": {
		"background": "var(--primary)",
		"foreground": "rgba(255, 255, 255, 1)",
		"shape": "var(--shape-popup)"
	},
	"media-emoji-tab:focus": {
		"foreground": "var(--primary)"
	},
	"glide-trail": {
		"foreground": "var(--primary)"
	}
}
